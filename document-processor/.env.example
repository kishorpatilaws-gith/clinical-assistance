# Copy to .env and fill in. .env is gitignored; this template is committed.
# Free cluster from https://cloud.qdrant.io
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<api key from the cluster's Access tab>
QDRANT_COLLECTION=clinical_chunks

# Evaluation harness (5.6) - hits the real .NET API, so it needs a doctor login
EVAL_API_URL=http://localhost:5258
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
EVAL_EMAIL=doctor@test.com
EVAL_PASSWORD=<password>
