# ---- Secrets (never commit) ----
secrets/
*.secret
*.pem
*.key
.env
.env.*
!.env.example
appsettings.Production.json
appsettings.Local.json
# Holds a real Supabase connection string; the canonical copy lives in dotnet user-secrets
appsettings.Development.json

# ---- .NET ----
bin/
obj/
*.user
*.suo
.vs/
artifacts/

# ---- Node / Next.js ----
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Python (document-processor, when it exists) ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Terraform ----
# .terraform.lock.hcl is deliberately NOT ignored — committing it pins the exact
# provider versions and hashes, which is the whole point of the lock file.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---- Editors / OS ----
.idea/
*.swp
.DS_Store
Thumbs.db
