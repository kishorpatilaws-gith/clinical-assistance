{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentProcessor": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 120,
    "IndexTimeoutSeconds": 3600
  },
  "Uploads": {
    "MaxBytes": 31457280
  }
}
